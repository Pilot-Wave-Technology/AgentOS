#!/bin/bash
TASK_ID="$1"
TYPE="${2:-progress}"
CONTENT="$3"
if [ -z "$TASK_ID" ] || [ -z "$CONTENT" ]; then
  echo "Usage: message-assistant <task_id> <type> <content>"
  exit 1
fi
GW_AGENT_ID=""
if [ -n "$OPENCLAW_AGENT_ID" ]; then
  GW_AGENT_ID="$OPENCLAW_AGENT_ID"
elif [[ "$PWD" =~ workspace-([^/]+)- ]]; then
  GW_AGENT_ID="${BASH_REMATCH[1]}"
fi
BODY=$(jq -n --arg content "$CONTENT" --arg type "$TYPE" --arg gw_id "$GW_AGENT_ID" \
  '{content: $content, type: $type, gateway_agent_id: $gw_id}')
curl -s -X POST "${CONTROL_PANEL_URL}/internal/tasks/${TASK_ID}/message-shca" \
  -H "Authorization: Bearer ${OPENCLAW_GATEWAY_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$BODY"
