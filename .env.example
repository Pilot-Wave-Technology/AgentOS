###############################################################################
# AgentOS control plane — configuration reference (.env.example)
#
# This lists EVERY setting the control plane reads, in one place.
#
#   • For a Cloud Run deploy: you do NOT edit this file. Terraform injects these
#     from terraform/terraform.tfvars (non-secrets) and Secret Manager (secrets).
#     This file is the human-readable reference for what each knob does.
#   • For LOCAL development: `cp .env.example .env` and fill it in.
#
# Lines marked [SECRET] must come from Secret Manager in production — never
# commit real values. Defaults shown are the current/safe values.
###############################################################################

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development                      # development | production
LOG_LEVEL=INFO                           # DEBUG for verbose gateway/DB logs
DEBUG=false
APP_SECRET_KEY=CHANGE_ME                 # [SECRET] session/CSRF signing key (openssl rand -hex 32)

# ─── Database (Cloud SQL Postgres) ───────────────────────────────────────────
# Local: a normal DSN. Cloud Run: unix-socket DSN, terraform-generated.
DATABASE_URL=postgresql://user:pass@localhost:5432/control_panel   # [SECRET]

# ─── Firebase auth ───────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-gcp-project
FIREBASE_WEB_API_KEY=your-firebase-web-api-key          # public client key (Firebase console)
FIREBASE_SERVICE_ACCOUNT_JSON=                          # [SECRET] SA JSON string or file path

# ─── OpenClaw gateway link ───────────────────────────────────────────────────
OPENCLAW_WS_URL=ws://GATEWAY_VM_INTERNAL_IP:18789
OPENCLAW_AUTH_TOKEN=                                    # [SECRET] gateway shared token
AGENT_TOKEN_SIGNING_KEY=                                # [SECRET] HMAC key for per-agent JWTs (empty = disabled)

# ─── Security / auth (leave ON for a secure deployment) ─────────────────────
AGENT_SCOPED_TOKENS_ENABLED=true         # per-agent JWTs on /internal/*
AGENT_AUTHZ_ENFORCE=true                 # 403 on cross-goal access
CUSTOM_TOOLS_BROKER_ENFORCE=true         # tools may only fetch declared credentials
AGENT_REJECT_SHARED_TOKEN=false          # flip ON only after all callers use JWTs
INTERNAL_API_KEY=                        # [SECRET] gateway → control-panel PEP bearer

# ─── Storage (GCS) ───────────────────────────────────────────────────────────
GCS_WORKSPACE_BUCKET_PREFIX=agentos-agent-ws    # per-goal buckets: <prefix>-<goalid>
GCS_RESOURCE_BUCKET=agentos-agent-resources     # shared resource uploads bucket
AGENT_ARCHIVE_BUCKET=agentos-agent-data         # archived memory/transcripts on delete

# ─── Task-runner job (async document rendering) ──────────────────────────────
TASK_RUNNER_JOB_NAME=agentos-task-runner        # empty = disabled (local dev)

# ─── Bootstrap ───────────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=you@example.com    # first user with this email becomes admin

# ─── GitHub App (repo/branch features) ───────────────────────────────────────
GITHUB_ORG=your-github-org
GITHUB_APP_ID=                           # empty = git features off
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_SECRET=           # [SECRET] the App .pem (content or Secret path)
GITHUB_WEBHOOK_SECRET=                   # [SECRET] X-Hub-Signature-256 secret (empty = skip check)

# ─── LLM providers ───────────────────────────────────────────────────────────
GEMINI_API_KEY=                          # [SECRET] used for summaries (Google AI Studio)
ANTHROPIC_API_KEY=                          # [SECRET] Anthropic API key
OPENAI_API_KEY=                          # [SECRET] optional (leave blank to disable)
# Models shown in UI dropdowns (JSON list). Omit to take the default in
# app/config.py, which matches the seeded Model Registry.
AVAILABLE_MODELS=["google/gemini-3.8-flash","anthropic/claude-opus-5-5","anthropic/claude-sonnet-5-5","anthropic/claude-haiku-4-5","claude-cli/opus","claude-cli/sonnet"]

# ─── Slack (optional) — configured AFTER deploy in the admin UI ──────────────
# Slack app credentials are entered in AgentOS (Settings → Integrations → Slack),
# not via env. Legacy env fallback exists only if slack_enabled=true in terraform:
#   SLACK_CLIENT_ID=  SLACK_CLIENT_SECRET=  SLACK_SIGNING_SECRET=  SLACK_COMMAND_SUFFIX=

# ─── Connect-via-Google (optional; per-goal SA provisioning) ─────────────────
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=                 # [SECRET]
GCP_OAUTH_REDIRECT_URL=                  # https://<app-url>/gcp/oauth/callback
GCP_VM_SA_EMAIL=                         # Cloud Run SA email (token creator on new SAs)

# ─── Custom tools ────────────────────────────────────────────────────────────
CREDENTIAL_ENCRYPTION_KEY=               # [SECRET] Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# ─── Chat delivery ───────────────────────────────────────────────────────────
CHAT_QUEUE_ENABLED=true                  # durable queue + co-located dispatcher
CHAT_GATEWAY_ID=gw-1                     # this instance's gateway id

# ─── memory_v2 ───────────────────────────────────────────────────────────────
MEMORY_V2_BRIDGE_ENABLED=true            # ledger events -> memory files
MEMORY_V2_FLUSH_ENABLED=true             # flush on story-complete / reap
MEMORY_V2_SNAPSHOT_ENABLED=false
MEMORY_V2_USER_MEMORY_ENABLED=false
MEMORY_V2_PERIODIC_SNAPSHOT_HOURS=6

# ─── Goal Review Council ─────────────────────────────────────────────────────
COUNCIL_DISPATCHER_ENABLED=true          # claim runs, spawn reviewer RAs, deliver to GO
COUNCIL_SCHEDULE_ENABLED=true
COUNCIL_KEEP_RA_WORKSPACES=false         # debug only

# ─── Security Council ────────────────────────────────────────────────────────
SECURITY_DISPATCHER_ENABLED=true         # branch security review dispatcher
SECURITY_UI_ENABLED=true                 # show the manual "run security review" button
SECURITY_SCHEDULE_ENABLED=true
SECURITY_SCHEDULE_HOURS=12
SECURITY_KEEP_AGENT_WORKSPACES=false     # debug only

# ─── Platform Research Council ───────────────────────────────────────────────
PLATFORM_COUNCIL_ENABLED=true            # master gate (ensures __platform__ goal + convener)
PLATFORM_RESEARCH_DISPATCHER_ENABLED=true
PLATFORM_SCHEDULE_ENABLED=false
PLATFORM_SCHEDULE_INTERVAL_DAYS=7
PLATFORM_DISCOVERY_SCHEDULE_ENABLED=false
PLATFORM_DISCOVERY_INTERVAL_DAYS=7
PLATFORM_RESEARCH_WATCHDOG_MINUTES=40
PLATFORM_WORKER_IDLE_MINUTES=30
PLATFORM_AGENTS_RECREATE_ON_BUILD=false  # true = refresh platform agents each deploy
PLATFORM_BUILD_SHA=                       # set to the build SHA to gate the once-per-build recreate
PLATFORM_REPO_NAME=agentos                # the control-plane repo the council researches
PLATFORM_CLONE_URL=                       # clone URL of that repo

# ─── Goal progress summaries ─────────────────────────────────────────────────
GOAL_SUMMARY_ENABLED=true
DASHBOARD_HEALTH_REFRESH_INTERVAL_SECONDS=300
DASHBOARD_MATVIEW_REFRESH_INTERVAL_SECONDS=3600

# ─── Git dependency-graph engine ─────────────────────────────────────────────
GITGRAPH_ENABLED=true                    # branch cut / sync / merge queue

# ─── claude-code story DAG concurrency ceiling ───────────────────────────────
TASK_DAG_CEILING=4
TASK_DAG_CEILING_ENFORCE=false           # shadow-only until you want hard limits

# ─── Kill switch (stuck-after-pause detection) ──────────────────────────────
STUCK_AFTER_PAUSE_IA_MINUTES=3
STUCK_AFTER_PAUSE_PHASE_MINUTES=5

# ─── Dispatch + ledger ───────────────────────────────────────────────────────
DISPATCH_MODE=chat_send
LEDGER_ACTOR_AUDIT=true

# ─── Service URLs (set after first deploy) ───────────────────────────────────
CONTROL_PANEL_URL=
MANAGEMENT_SERVICE_URL=
MAIN_SERVICE_URL=
