###############################################################################
# AgentOS control plane — YOUR configuration.
#
#   cp terraform.tfvars.example terraform.tfvars   # then edit this copy
#
# This is the ONE file you edit. It has two kinds of entries:
#   • INPUTS you must / may provide (project, org, emails, sizes)
#   • FLAGS that turn service behaviour on/off (defaults = current config)
#
# Secret *values* are NOT here — prerequisites.sh creates + fills every secret;
# overwrite any you left blank later with ../set-secret.sh (see
# deploy/06-fill-in-secrets.md).
###############################################################################

# ─── 1. Project / region (REQUIRED) ────────────────────────────────────────
project_id            = "my-agentos-project"     # <-- your GCP project (you own it)
region                = "us-central1"
name_prefix           = "agentos"                # short lowercase; prefixes resources

# ─── 2. External services ──────────────────────────────────────────────────
firebase_project_id   = "my-agentos-project"     # usually same as project_id
firebase_web_api_key  = "AIza...FILL_ME"         # Firebase console > Project settings (public key)
bootstrap_admin_email = "you@example.com"        # first login becomes platform admin

# Your AgentOS FORK — the SAME URL as the gateway stack's repo_url. See FORKING.md.
repo_url                   = "https://github.com/YOUR_ORG/AgentOS.git"

# GitHub App (REQUIRED) — the org where AGENTS create + work on goal repos (NOT
# the fork). Create + install the App on that org, then fill in all three. Full
# steps: deploy/02-github-app.md.
github_org                 = "my-github-org"      # REQUIRED
github_app_id              = "1234567"            # REQUIRED
github_app_installation_id = "98765432"           # REQUIRED

# Slack (optional)
slack_enabled         = false
slack_client_id       = ""
slack_command_suffix  = ""                        # e.g. "prod" -> /goal-prod

# ─── 3. LLM providers ──────────────────────────────────────────────────────
# Toggle which provider key secrets are wired into the services. The keys
# themselves come from prerequisites.sh (secrets.env, or set-secret.sh) — not
# from this file, and not after apply. Anthropic + Gemini power agents and
# summaries and are required; OpenAI is optional. (The gateway VM also
# consumes these — see agent_os_openclaw.)
anthropic_enabled     = true
gemini_enabled        = true
openai_enabled        = false                     # set true to provision an OpenAI key slot

# Models offered in the UI dropdowns. The gateway learns its models from
# the control panel's Model Registry, so this is the platform's list only. Keep in sync with
# `app/config.py::available_models`; omit the block entirely to take
# the terraform default, which already matches it.
available_models = [
  "google/gemini-3.8-flash",
  "anthropic/claude-opus-5-5",
  "anthropic/claude-sonnet-5-5",
  "anthropic/claude-haiku-4-5",
  "claude-cli/opus",
  "claude-cli/sonnet",
]

# ─── 4. Database (Cloud SQL Postgres) ──────────────────────────────────────
# Created HERE: the instance, the "control_panel" database, app_user +
# migrate_user and their DSN secrets. Creating the instance takes several
# minutes. Defaults shown; uncomment to change.
# db_tier                = "db-custom-2-8192"
# db_version             = "POSTGRES_17"
# db_disk_gb             = 250
# db_deletion_protection = true    # false only on a throwaway project

# ─── 5. Networking ─────────────────────────────────────────────────────────
# Standard 2-stage deploy: the GATEWAY (Stage ①) already created this VPC, so the
# platform REUSES it -> keep this false and set network_name to the gateway's
# `network_name` output. Only set true if you are NOT deploying the gateway stack.
create_network        = false                     # false = reuse the gateway's VPC
network_name          = "agentos-vpc"             # = gateway output: network_name
connector_cidr        = "10.8.0.0/28"             # /28 for the Serverless VPC connector

# ─── 6. Storage buckets (globally unique; empty = auto-derived) ─────────────
workspace_bucket_prefix = ""                      # default: <name_prefix>-agent-ws
resource_bucket         = ""                      # default: <name_prefix>-agent-resources-<project>
archive_bucket          = ""                      # default: <name_prefix>-agent-data-<project>

# ─── 7. Gateway (OpenClaw VM) ──────────────────────────────────────────────
# Nothing to set: the gateway stack reserves its VM's internal address as
# <name_prefix>-gateway-ip, and this stack derives ws://<address>:18789 from it.
# Override only if your gateway lives somewhere else:
# openclaw_ws_url     = "ws://10.20.0.4:18789"

# ─── 8. Cloud Run sizing + profile ─────────────────────────────────────────
# Container images. Leave these commented: the apply creates the services on a
# placeholder (hello) image, and the Cloud Build run in
# deploy/07-build-and-deploy.md replaces it with the real one (terraform
# ignores image changes, so the two don't fight). Set them only to pin an
# image you already built.
# image             = "gcr.io/my-agentos-project/agentos:latest"
# task_runner_image = "gcr.io/my-agentos-project/agentos-task-runner:latest"

service_cpu           = "2"
service_memory        = "4Gi"
service_min_instances = 1                          # keep >=1 so co-located loops stay warm
service_max_instances = 3
enable_task_runner    = true

# ─── Execution plane ────────────────────────────────────────────────────────
# Always created: every executor runs on this GKE cluster, one pod per leg.
# The platform pool floors at two e2-standard-4, so it costs money
# continuously, whether or not a story is running.
# execution_node_disk_gb    = 100
# execution_small_min_nodes = 1   # keep one node warm; 0 waits for one

# ─── 9. Feature flags (defaults = current running config) ───────────────────
# Turn things off here for a leaner deployment; the loops are DB-lock guarded,
# so a flag only decides whether the work happens, never where.
flags = {
  # -- security / auth (leave ON for a secure deployment) --
  agent_scoped_tokens_enabled   = true    # per-agent JWTs on /internal/*
  agent_authz_enforce           = true    # 403 on cross-goal access
  custom_tools_broker_enforce   = true    # tools may only fetch declared credentials

  # -- chat delivery --
  chat_queue_enabled            = true
  chat_gateway_id               = "gw-1"

  # -- memory v2 --
  memory_v2_bridge_enabled      = true    # ledger events -> memory files
  memory_v2_flush_enabled       = true    # flush memory on story-complete / reap
  memory_v2_snapshot_enabled    = true
  memory_v2_user_memory_enabled = false

  # -- goal review council (reviews stories, reports to the GO) --
  council_dispatcher_enabled    = true
  council_schedule_enabled      = true

  # -- security council (branch security review) --
  # OFF, matching the environment this release is cut from. It spawns
  # six reviewer agents per run and needs gitleaks and semgrep in the
  # sandbox image; turn it on once the basics are working.
  security_dispatcher_enabled   = false
  security_ui_enabled           = false    # show the manual "run security review" button
  security_schedule_enabled     = false
  security_schedule_hours       = 12

  # -- platform research council (self-improvement research) --
  # OFF, matching the environment this release is cut from. It creates
  # a standing __platform__ goal and researches AgentOS itself, which
  # is interesting and is not what a new installation needs on day one.
  # It also spends tokens continuously.
  platform_council_enabled             = false
  platform_research_dispatcher_enabled = false
  platform_agents_recreate_on_build    = true   # refresh platform agents each deploy

  # -- goal progress summaries --
  goal_summary_enabled          = true

  # -- git dependency-graph engine (branch cut / merge queue) --
  gitgraph_enabled              = true

  # -- claude-code story DAG concurrency ceiling --
  task_dag_ceiling              = 4
  task_dag_ceiling_enforce      = false   # shadow-only until you want hard limits

  # -- misc --
  ledger_actor_audit            = true
  log_level                     = "INFO"  # DEBUG for verbose gateway/DB logs
}
