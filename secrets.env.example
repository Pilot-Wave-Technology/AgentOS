# AgentOS — optional local secret values for prerequisites.sh.
#   cp secrets.env.example secrets.env    # then fill in what you have
#   ./prerequisites.sh <PROJECT_ID> [REGION]
#
# EVERY line is OPTIONAL. Anything you leave blank becomes:
#   • internal keys  -> auto-generated by prerequisites.sh
#   • external values -> a BLANK secret version you overwrite later with:
#       printf %s 'REAL_VALUE' | ./set-secret.sh <name>
#     (never raw `gcloud secrets versions add`)
#
# NEVER commit secrets.env (it's in .gitignore).

# ── LLM providers (REQUIRED: Gemini AND Anthropic; OpenAI optional) ──────────
GEMINI_API_KEY=            # REQUIRED
CLAUDE_API_KEY=            # REQUIRED (Anthropic)
OPENAI_API_KEY=            # optional

# ── MULTI-LINE secrets (Firebase JSON key + GitHub App .pem) ─────────────────
# Don't paste multi-line content into this file. Instead drop each file next to
# secrets.env and point a *_FILE variable at it — prerequisites.sh reads the file
# and creates the secret for you (no separate set-secret step, no manual
# `gcloud secrets versions add`). Path is relative to where you run the script.
FIREBASE_SERVICE_ACCOUNT_JSON_FILE=    # e.g. firebase-sa.json      (REQUIRED for login)
GITHUB_APP_KEY_FILE=                   # e.g. github-app-key.pem    (REQUIRED for agent git work)

# ── GitHub App (REQUIRED for agent git work) ─────────────────────────────────
# The App id/installation id go in terraform.tfvars; the App private key (.pem)
# and (if you enable webhooks) the webhook secret are secrets. See 02-github-app.md.
GITHUB_WEBHOOK_SECRET=     # recommended (optional) — `openssl rand -hex 32`; empty disables webhook signature verification

# ── Slack (optional) — configured AFTER deploy in the admin UI ───────────────
# Nothing to fill in here. Slack credentials are entered in AgentOS at
# Settings → Integrations → Slack once the platform is live (deploy/03-slack-app.md).

# ── Private-repo clone ───────────────────────────────────────────────────────
# If your AgentOS fork is PRIVATE, the gateway VM clones it with this token.
# Use a FINE-GRAINED GitHub token scoped to ONLY your fork, Contents: Read-only
# (Settings > Developer settings > Fine-grained tokens). Step-by-step in
# deploy/04-collect-your-values.md. Blank = public fork (no token needed).
GATEWAY_REPO_TOKEN=

# ── Internal keys — leave blank to auto-generate (recommended) ───────────────
APP_SECRET_KEY=
INTERNAL_API_KEY=
AGENT_TOKEN_SIGNING_KEY=
OPENCLAW_GATEWAY_TOKEN=
CREDENTIAL_ENCRYPTION_KEY=
